{
  "manifestVersion": 3,
  "id": "openpets.work-life",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "1.0.0",
  "runtime": "javascript",
  "icon": "clock",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "assets": {
    "icons": {
      "work-life": "assets/work-life.svg"
    }
  },
  "permissions": [
    "pet:speak",
    "pet:interact",
    "schedule",
    "storage",
    "events",
    "commands",
    "status"
  ],
  "configSchema": {
    "workThresholdMinutes": {
      "type": "select",
      "default": "120",
      "label": "$t:config.workThresholdMinutes.label",
      "description": "$t:config.workThresholdMinutes.description",
      "options": [
        { "value": "60", "label": "$t:config.workThresholdMinutes.60" },
        { "value": "90", "label": "$t:config.workThresholdMinutes.90" },
        { "value": "120", "label": "$t:config.workThresholdMinutes.120" },
        { "value": "180", "label": "$t:config.workThresholdMinutes.180" }
      ]
    },
    "reminderIntervalMinutes": {
      "type": "select",
      "default": "60",
      "label": "$t:config.reminderIntervalMinutes.label",
      "description": "$t:config.reminderIntervalMinutes.description",
      "options": [
        { "value": "30", "label": "$t:config.reminderIntervalMinutes.30" },
        { "value": "60", "label": "$t:config.reminderIntervalMinutes.60" },
        { "value": "90", "label": "$t:config.reminderIntervalMinutes.90" }
      ]
    }
  }
}